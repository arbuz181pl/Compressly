# Normalise text files to LF in the repository.
* text=auto eol=lf

# gradlew must stay LF or it fails on Linux/macOS.
gradlew text eol=lf

# Windows batch scripts need CRLF.
*.bat text eol=crlf

# Binaries
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.aar binary
*.so binary
*.keystore binary
*.jks binary
LICENSE text eol=lf